{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-plane.local/contracts/registry/roles.registry.v1.json",
  "x-contract": {
    "contract_id": "C-REG-ROLES-1",
    "contract_version": 1,
    "owner": "L0",
    "publishing_lane": "L1",
    "consuming_lanes": [
      "L1",
      "L3",
      "L5"
    ],
    "spec_refs": [
      "Section 8",
      "Section 8 (D106)",
      "Section 9.1"
    ],
    "ccr_required": true,
    "notes": [
      "D-L0-09: founder default_capabilities is empty; lifecycle-decision and people-intelligence are granted by explicit people.yaml entry only (D106)."
    ]
  },
  "type": "object",
  "required": [
    "registry_version",
    "roles"
  ],
  "additionalProperties": false,
  "properties": {
    "registry_version": {
      "const": 1
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "default_capabilities"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "default_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "not": {
              "contains": {
                "enum": [
                  "production-approval",
                  "platform-change-approval",
                  "platform-admin",
                  "security-review",
                  "migration-review",
                  "exceptional-approval",
                  "lifecycle-decision",
                  "people-intelligence"
                ]
              }
            },
            "description": "D106: no role default may carry a dangerous capability"
          }
        }
      }
    }
  }
}
