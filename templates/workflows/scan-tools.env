# Scan toolchain — resolved per FD-107 / PFD-027 (2026-09-08):
# Trivy for security scanning, Syft for SBOM generation, spdx-json format.
# Spec Sections 33.2 (security and licence scan), 48.2 (licence scanning),
# 48.3 (SBOM per artifact). Every image is referenced BY DIGEST, never by tag.
#
# Digests below are the ghcr.io multi-arch image-index digests for each
# tool's `latest` tag, resolved 2026-09-15 (see .github/workflows/_pins/
# resolve-pins.sh for the equivalent pattern applied to GitHub Actions).
# Re-resolve before a release cut if the pin needs to move forward:
#   TOKEN=$(curl -sS "https://ghcr.io/token?scope=repository:<repo>:pull&service=ghcr.io" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
#   curl -sS -D - -o /dev/null -H "Authorization: Bearer $TOKEN" \
#     -H "Accept: application/vnd.oci.image.index.v1+json" \
#     "https://ghcr.io/v2/<repo>/manifests/latest" | grep -i digest
SECURITY_SCANNER_IMAGE=ghcr.io/aquasecurity/trivy
SECURITY_SCANNER_DIGEST=sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969
SECURITY_SCANNER_SARIF_PATH=records/security/trivy.sarif
LICENCE_SCANNER_IMAGE=ghcr.io/aquasecurity/trivy
LICENCE_SCANNER_DIGEST=sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969
LICENCE_SCANNER_REPORT_PATH=records/security/licence-report.json
SBOM_GENERATOR_IMAGE=ghcr.io/anchore/syft
SBOM_GENERATOR_DIGEST=sha256:95fe0835e5bebc6f8b1f8acef68d47d63d594ef4c0f25c097ff853b23cbac74c
SBOM_FORMAT=spdx-json
