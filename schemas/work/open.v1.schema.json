{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:multiproduct:schemas:work:open:v1",
  "title": "Open Work Snapshot",
  "description": "Open work items snapshot (orphan detection surface, FD-108)",
  "type": "object",
  "required": ["items"],
  "properties": {
    "_meta": { "type": "object" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "assignee": { "type": "string" },
          "column": { "type": "string" },
          "product_id": { "type": "string" }
        }
      }
    }
  }
}
