{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:multiproduct:schemas:board:snapshot:v1",
  "title": "Board Snapshot",
  "description": "Board layout snapshot for orphan detection (FD-108/PFD-031)",
  "type": "object",
  "required": ["columns"],
  "properties": {
    "_meta": { "type": "object" },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "items": { "type": "array" }
        }
      }
    }
  }
}
