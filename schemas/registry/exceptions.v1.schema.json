{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:multiproduct:schemas:registry:exceptions:v1",
  "title": "Exceptions Registry",
  "description": "Bootstrap exceptions registry (L1, FD-109)",
  "type": "object",
  "required": ["id", "reason", "granted_by", "expires"],
  "properties": {
    "id": { "type": "string" },
    "reason": { "type": "string" },
    "granted_by": { "type": "string" },
    "expires": { "type": "string", "format": "date" },
    "gate": { "type": "string" }
  }
}
