{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:multiproduct:schemas:registry:patterns:v1",
  "title": "Failure Pattern Registry (patterns.yaml) v1",
  "description": "Confirmed failure patterns and remediation links; closed Section 58.3 remediation enum (L1-608/L1-935, FD-096 flat layout)",
  "x-spec": "Sections 58.2, 58.3, 52.6, AT-040",
  "x-residual-rule": [
    "Section 58.3 / AT-040: a pattern is confirmed on the third occurrence; the rule (R-PAT-01) counts occurrences, the schema only requires the array be non-empty.",
    "Section 58.1: the pattern detector reads records/incidents and records/postmortems (Lane 4's repository) and is scheduled by subsystem O, unassigned in PARTITION v1; not built here."
  ],
  "type": "object",
  "required": ["registry_version", "patterns"],
  "additionalProperties": false,
  "properties": {
    "registry_version": { "type": "integer", "minimum": 1 },
    "patterns": {
      "type": "array",
      "items": { "$ref": "#/$defs/pattern" }
    }
  },
  "$defs": {
    "pattern": {
      "type": "object",
      "required": [
        "id", "root_class", "occurrences", "remediation_type",
        "work_item", "closure_condition", "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^PAT-\\d{4}-\\d{3}$" },
        "root_class": { "type": "string", "minLength": 1 },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["record_ref", "date"],
            "additionalProperties": false,
            "properties": {
              "record_ref": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
            }
          }
        },
        "remediation_type": {
          "type": "string",
          "enum": [
            "architecture_change",
            "automation",
            "permanent_test",
            "policy_change",
            "product_lifecycle_decision",
            "staffing_decision"
          ]
        },
        "work_item": { "type": "string", "minLength": 1 },
        "closure_condition": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["open", "closed"] }
      }
    }
  }
}
