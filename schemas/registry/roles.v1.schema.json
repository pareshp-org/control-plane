{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:multiproduct:schemas:registry:roles:v1",
  "title": "Roles Registry",
  "description": "Registry of roles (L1-02, FD-096)",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "lane_scope": { "type": "string" }
  }
}
