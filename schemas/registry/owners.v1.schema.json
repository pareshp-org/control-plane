{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-plane.local/schemas/registry/owners.v1.schema.json",
  "title": "Owner manifest for the registry-change lane (registries/OWNERS.yaml) -- L1-505",
  "description": "Section 52.6 (the complete inventory and its Owner column); Section 26.4 (the file's declared owner reviews the edit); Section 0.7.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "declared_count", "artifacts"],
  "properties": {
    "registry_version": { "const": 1 },
    "declared_count": { "type": "integer", "minimum": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owner", "per_entry_owner", "repository", "purpose"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "owner": {
            "enum": [
              "founder",
              "team_lead",
              "qa",
              "primary_owner",
              "service_owner",
              "change_owner",
              "record_generator",
              "event_emitter"
            ]
          },
          "per_entry_owner": { "type": "boolean" },
          "repository": {
            "enum": [
              "control-plane",
              "control-plane-records",
              "product",
              "off-repository"
            ]
          },
          "purpose": { "type": "string", "minLength": 1 },
          "custody": { "type": ["string", "null"] }
        }
      }
    }
  }
}
