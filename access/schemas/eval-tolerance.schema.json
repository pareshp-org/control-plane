{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-needs-urn": "FD-050: replace with urn:multiproduct:schemas:<type>:<version>",
  "$id": "https://control-plane.invalid/access/eval-tolerance.schema.json",
  "x-target": "access/ai-toolchain/checks/eval-tolerance.yaml",
  "title": "AI-eval regression tolerance and SIG-42 routing (spec Section 38.3, Section 52.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "spec_sections", "decisions", "signal", "signal_name", "tolerance",
               "severity", "routed_to", "response_sla", "triage_slot", "coalescing_rule",
               "arming_note", "implemented_by", "owned_elsewhere"],
  "properties": {
    "document": {"const": "eval-tolerance"},
    "spec_sections": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "signal": {"const": "SIG-42"},
    "signal_name": {"type": "string", "minLength": 1},
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "rule"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "rule": {"type": "string", "minLength": 1}
      }
    },
    "severity": {"enum": ["Red", "Yellow", "Green"]},
    "routed_to": {"type": "string", "minLength": 1},
    "response_sla": {"type": "string", "minLength": 1},
    "triage_slot": {"type": "string", "minLength": 1},
    "coalescing_rule": {"type": "string", "minLength": 1},
    "arming_note": {"type": "string", "minLength": 1},
    "implemented_by": {"type": "string", "minLength": 1},
    "owned_elsewhere": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "owned_by_lane"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "owned_by_lane": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5"]}
        }
      }
    }
  }
}
